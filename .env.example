# =====================================================================
# LearnHub Employee Demographics & QR Barcode Portal - Environment Example
# Copy this file to .env and adjust variables as needed.
# =====================================================================

# Application Identity
VITE_APP_NAME="LearnHub Employee Management Portal"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="development"
VITE_PORT=3000

# Backend & Relational Storage Config
VITE_API_BASE_URL="https://api.learnhub.app/v1"
VITE_API_TIMEOUT=15000

# Workforce Verification & QR Barcode Settings
VITE_BARCODE_BASE_URL="https://learnhub.app/emp/scan/"
VITE_BARCODE_SCANNER_FPS=10
VITE_MAX_FILE_SIZE_MB=5

# Compensation & Localization Engine
VITE_DEFAULT_CURRENCY="INR"
VITE_DEFAULT_LOCALE="en-IN"
VITE_CURRENCY_SYMBOL="₹"
