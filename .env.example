# =====================================================================
# Background Verification System - Environment Example
# Copy this file to .env and adjust values for your local environment.
# =====================================================================

# Application Identity
VITE_APP_NAME="Background Verification Portal"
VITE_APP_DESCRIPTION="Employee Demographics, Employment History & Verification System"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="development"
VITE_PORT=3000

# Prisma & PostgreSQL Database Connection Config
DATABASE_URL="postgresql://postgres:131006@localhost:5432/bg_verification?schema=public"

DB_HOST="localhost"
DB_PORT=5432
DB_NAME="bg_verification"
DB_USER="postgres"
DB_PASSWORD="131006"
DB_SSL=false

# Backend & Relational Storage API Config
VITE_API_BASE_URL="http://localhost:3000/api/v1"
VITE_API_TIMEOUT=15000

# Verification & Barcode / QR Code Settings
VITE_BARCODE_BASE_URL="http://localhost:3000/emp/verify/"
VITE_BARCODE_SCANNER_FPS=10
VITE_MAX_FILE_SIZE_MB=5

# Compensation & Localization Engine
VITE_DEFAULT_CURRENCY="INR"
VITE_DEFAULT_LOCALE="en-IN"
VITE_CURRENCY_SYMBOL="₹"

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID="rzp_test_BGVerifKey2026"
RAZORPAY_KEY_SECRET="BGVerifSecretKey2026SecurePass"
VITE_RAZORPAY_KEY_ID="rzp_test_BGVerifKey2026"
